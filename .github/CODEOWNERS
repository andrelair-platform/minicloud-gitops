# Ownership map for routing/review suggestions. GitHub does not require a CODEOWNER
# approval because this is a solo-maintainer repository. Production changes still require
# a PR, the required merge-gate check, all applicable CI checks, and signed commits.
# Kargo prepares production PRs; the maintainer reviews the diff and merges after checks pass.

# Production overlays (all services)
services/*/overlays/prod/     @AndreLiar
services/*/minicloud-1/prod/  @AndreLiar

# Base (shared) — prod overlays inherit base/, so ownership applies to shared changes too.
services/*/base/              @AndreLiar

# Helm wrapper charts (GAP golden path) — values-prod.yaml carries the prod image tag + prod
# config, and Chart.yaml pins the library version. This is the prod config location since the
# wrapper migration, so it is a key production configuration path.
services/*/helm/              @AndreLiar

# Kargo Project/Warehouse/Stage manifests define the promotion machinery; retain ownership mapping.
services/*/kargo/             @AndreLiar
platform/delivery/kargo/      @AndreLiar

# ArgoCD Application manifests — these DEFINE the deploy gate (syncPolicy,
# targetRevision, source path). (CI bumps image newTags in overlays, never apps/.)
apps/                         @AndreLiar

# Production quota and network-policy manifests
platform/security/quotas/*-prod.yaml  @AndreLiar
platform/security/network-policies/*-prod.yaml @AndreLiar

# Helm values — any change here affects running platform tools
helm-values/                  @AndreLiar
helm-values/minicloud-1/      @AndreLiar

# Bootstrap — changing root-app.yaml affects the entire cluster
bootstrap/                    @AndreLiar

# RBAC — security-sensitive
platform/security/rbac/       @AndreLiar

# Agent operating config — the Claude Code hooks (deterministic guardrails / approval
# gates) and the auto-loaded rules constitution. A change here alters what the agent is
# allowed to do, so keep its ownership visible (agentic-guardrails.md).
.claude/settings.json         @AndreLiar
.claude/hooks/                @AndreLiar
.claude/rules/                @AndreLiar
.claude/skills/               @AndreLiar
.claude/commands/             @AndreLiar
.claude/agents/               @AndreLiar
REVIEW.md                     @AndreLiar
evals/                        @AndreLiar
.github/workflows/agent-config-evals.yml @AndreLiar
